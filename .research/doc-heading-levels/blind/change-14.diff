+    /// An empty `LPStd` (`cbStd` = 0). Fixed-index slots 13–14 MUST be empty
+    /// (§2.9.271) and 0–12 MAY be.
+    fn empty_lpstd() -> Vec<u8> {
+        vec![0, 0]
+    }
