+        wd[0x42B..0x42D].copy_from_slice(&0x0000u16.to_le_bytes()); // istd = 0 (Normal)
+        // grpprl: 0x6412 (LE) + 4-byte operand (low byte = 5) + 1 pad byte.
+        wd[0x42D..0x434].copy_from_slice(&[0x12, 0x64, 0x05, 0x00, 0x00, 0x00, 0x00]);
+        wd[0x5FF] = 2; // crun = 2
